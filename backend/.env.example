# ── LLM / CrewAI Orchestration (Groq & Google Gemini) ─────────────────────────
GROQ_API_KEY=<your-groq-api-key>
GEMINI_API_KEY=<your-gemini-api-key>
LITELLM_DROP_PARAMS=True
CHRONOS_FORCE_DETERMINISTIC=false

# ── Neo4j AuraDB (Graph Topology & SOC Copilot) ───────────────────────────────
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-neo4j-password>

# ── MongoDB Atlas (Persistent Session Store & RAG Incident Vector Store) ──────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=chronos_dev
RAG_VECTOR_INDEX_NAME=incident_vector_index
RAG_MIN_SIMILARITY=0.15

# ── AWS IAM & EC2 (Read-Only Cloud Remediation Drafting) ──────────────────────
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
AWS_DEFAULT_REGION=us-east-1
CHRONOS_USE_MOCK_AWS=true

